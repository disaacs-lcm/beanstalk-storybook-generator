OPENAI_API_KEY=
# Google sign-in: an OAuth "Web application" client from console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Any long random string; keep it the same across deploys.
SECRET_KEY=
# Postgres on Render; leave unset locally to use storybook.db (SQLite)
# DATABASE_URL=
# IMAGE_PROVIDER=fake     # free placeholder images for testing; "openai" (default) draws real ones
# DEV_LOGIN=1             # adds a local-only test sign-in at /login/dev
# IMAGE_MODEL=gpt-image-2.5-flare
# IMAGE_QUALITY=low
# RATE_LIMIT_PER_HOUR=100
# LOG_LEVEL=INFO
# CONTACT_EMAIL=           # shown on /privacy for deletion requests
